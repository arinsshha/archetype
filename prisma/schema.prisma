generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Result {
  id        String   @id @default(cuid())
  sums      String
  paid      Boolean  @default(false)
  orderId   String?
  paymentId String?
  createdAt DateTime @default(now())
}